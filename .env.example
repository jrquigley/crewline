APP_BASE_URL=https://shifts.quigspace.com
# First start only. Choose your real email and a unique password (15+ characters).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-me-with-a-unique-private-password
TRUST_PROXY=true
# Terminate HTTPS at your reverse proxy. Do not expose the app port to untrusted clients.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
SEED_SAMPLE_DATA=true
# Optional email transport. Leave SMTP_HOST empty to keep outbound email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crewline <schedule@quigspace.com>
SMTP_TLS=true
SMTP_SSL=false
# Optional; otherwise a random secret is generated and persisted in /data/secret.key.
# DJANGO_SECRET_KEY=
