{
  "name": "crewline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Event staff scheduling server; archived interface preview tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-preview.mjs",
    "start": "python app/manage.py runservice",
    "pretest": "node scripts/build-preview.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "check": "node scripts/build-preview.mjs --check",
    "preview": "node server/index.mjs",
    "test:app": "python app/manage.py test scheduling --noinput",
    "test:app-browser": "node scripts/app-browser.cjs"
  }
}
